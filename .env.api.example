# API only. Fill new Wanwu secrets locally; never commit the real .env.api.
# WANWU_DATABASE_URL must use wanwu_app and database wanwu_sound.
WANWU_DATABASE_URL=
WANWU_SESSION_SECRET=
WANWU_APP_ORIGIN=https://voiceatalass.netlify.app
WANWU_CLOUD_AUTH_MODE=disabled
# Exact verified proxy IPs only; the real Docker gateway is checked at deployment.
WANWU_TRUSTED_PROXY_ADDRESSES=
WANWU_API_PORT=3100
WANWU_API_HOST=127.0.0.1
# Private OSS. RAM permissions must cover only this new project prefix.
WANWU_OSS_BUCKET=wanwu-sound-dev-a7k3
WANWU_OSS_REGION=oss-cn-shanghai
WANWU_OSS_PREFIX=wanwu/dev
WANWU_OSS_ACCESS_KEY_ID=
WANWU_OSS_ACCESS_KEY_SECRET=
