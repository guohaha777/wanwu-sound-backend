diff --git a/packages/audio-engine/src/pcm.ts b/packages/audio-engine/src/pcm.ts
new file mode 100644
index 0000000000000000000000000000000000000000..79eb5f61d2eda2b5cf2ce13bddbf70f687a29725
--- /dev/null
+++ b/packages/audio-engine/src/pcm.ts
@@ -0,0 +1,54 @@
+/** Small bounded PCM helpers; RIFF is decoded only after FFmpeg writes a canonical derivative. */
+export const RENDER_SAMPLE_RATE=48000;
+export type Pcm={sampleRate:number;channels:Float32Array[]};
+
+export function pcm16Wave(channels:readonly Float32Array[],sampleRate=RENDER_SAMPLE_RATE):Uint8Array<ArrayBuffer>{
+ const frames=channels[0]?.length??0;
+ if(!frames||channels.length>2||channels.some(channel=>channel.length!==frames)
+  ||!Number.isInteger(sampleRate)||sampleRate<8000||sampleRate>192000||frames>sampleRate*91)throw new Error('invalid-pcm');
+ const bytes=new Uint8Array(44+frames*channels.length*2),view=new DataView(bytes.buffer);
+ const word=(at:number,value:string)=>{for(let i=0;i<value.length;i++)bytes[at+i]=value.charCodeAt(i);};
+ word(0,'RIFF');view.setUint32(4,bytes.length-8,true);word(8,'WAVE');word(12,'fmt ');
+ view.setUint32(16,16,true);view.setUint16(20,1,true);view.setUint16(22,channels.length,true);
+ view.setUint32(24,sampleRate,true);view.setUint32(28,sampleRate*channels.length*2,true);
+ view.setUint16(32,channels.length*2,true);view.setUint16(34,16,true);word(36,'data');view.setUint32(40,bytes.length-44,true);
+ for(let i=0;i<frames;i++)for(let c=0;c<channels.length;c++){
+  const sample=channels[c]![i]!;if(!Number.isFinite(sample))throw new Error('non-finite-pcm');
+  const clipped=Math.max(-1,Math.min(1,sample));view.setInt16(44+(i*channels.length+c)*2,Math.round(clipped*(clipped<0?32768:32767)),true);
+ }
+ return bytes;
+}
+
+export function readPcm16Wave(bytes:Uint8Array):Pcm{
+ const fail=()=>{throw new Error('invalid-pcm-wave');};
+ if(bytes.length<44)return fail();
+ const view=new DataView(bytes.buffer,bytes.byteOffset,bytes.byteLength);
+ const word=(at:number,length:number)=>String.fromCharCode(...bytes.subarray(at,at+length));
+ if(word(0,4)!=='RIFF'||word(8,4)!=='WAVE'||view.getUint32(4,true)+8!==bytes.length)return fail();
+ let channels=0,sampleRate=0,alignment=0,data:Uint8Array|null=null;
+ for(let at=12;at+8<=bytes.length;){
+  const size=view.getUint32(at+4,true),start=at+8,end=start+size;
+  if(end>bytes.length)return fail();
+  if(word(at,4)==='fmt '){
+   if(size<16||view.getUint16(start,true)!==1||view.getUint16(start+14,true)!==16)return fail();
+   channels=view.getUint16(start+2,true);sampleRate=view.getUint32(start+4,true);alignment=view.getUint16(start+12,true);
+  }
+  if(word(at,4)==='data'){if(data)return fail();data=bytes.subarray(start,end);}
+  at=end+(size%2);
+ }
+ if(!data||!data.length||channels<1||channels>2||alignment!==channels*2||data.length%alignment
+  ||sampleRate<8000||sampleRate>192000||data.length/alignment>sampleRate*91)return fail();
+ const samples=new DataView(data.buffer,data.byteOffset,data.byteLength),frames=data.length/alignment;
+ const output=Array.from({length:channels},()=>new Float32Array(frames));
+ for(let i=0;i<frames;i++)for(let c=0;c<channels;c++)output[c]![i]=samples.getInt16((i*channels+c)*2,true)/32768;
+ return {sampleRate,channels:output};
+}
+
+export function pcmMetrics(channels:readonly Float32Array[]){
+ let peak=0,square=0,count=0;
+ for(const channel of channels)for(const sample of channel){
+  if(!Number.isFinite(sample))throw new Error('non-finite-pcm');
+  peak=Math.max(peak,Math.abs(sample));square+=sample*sample;count++;
+ }
+ return {peak,rms:Math.sqrt(square/Math.max(1,count)),frames:channels[0]?.length??0};
+}
diff --git a/packages/audio-engine/src/render.ts b/packages/audio-engine/src/render.ts
new file mode 100644
index 0000000000000000000000000000000000000000..781ba46d6b7eb5d1e7fbe368b007364a9c77cdf5
--- /dev/null
+++ b/packages/audio-engine/src/render.ts
@@ -0,0 +1,111 @@
+import {parseArrangement} from '@wanwu-v2/contracts/arrangement';
+import type {Arrangement} from '@wanwu-v2/contracts/arrangement';
+import {parseComposeSettings} from '@wanwu-v2/contracts/work';
+import type {ComposeSettings} from '@wanwu-v2/contracts/work';
+import type {TextbookTrack} from '@wanwu-v2/contracts/textbook';
+import {isTextbookTrack} from '@wanwu-v2/contracts/textbook';
+import {analyseSamples} from '@wanwu-v2/sound-rules/analysis';
+import {assignParts,backgroundPlan} from '@wanwu-v2/sound-rules/background';
+import {MIX_RULES,RULE_VERSIONS} from '@wanwu-v2/sound-rules/rules';
+import {planClip,shapeKey} from '@wanwu-v2/sound-rules/shaping';
+import {renderShaped} from './shaping.ts';
+import {renderBackground} from './background.ts';
+import {LOCAL_INSTRUMENTS} from './instruments.ts';
+import {pieceSeconds,planPlayback,timedEvents} from './timeline.ts';
+import {RENDER_SAMPLE_RATE} from './pcm.ts';
+import {isSoundAnalysis} from '@wanwu-v2/contracts/sound';
+import type {SoundAnalysis} from '@wanwu-v2/contracts/sound';
+
+export {RENDERER_VERSION,TIMBRE_VERSION} from './version.ts';
+export type RenderInput={arrangement:Arrangement;settings:ComposeSettings;textbook:TextbookTrack|null;rules:typeof RULE_VERSIONS;
+ /** Internal worker-only bounds, derived from a hash-verified bundled catalogue; never accepted in work JSON. */
+ sourceLimits?:Record<string,number>;
+ /** Worker-only facts from an immutable server snapshot, after verifying each derivative's exact SHA-256. */
+ sourceFacts?:Record<string,{checksum:string;analysis:SoundAnalysis}>};
+export type SourceLoader=(id:string)=>Promise<AudioBuffer>;
+
+/** Identity/asset authorization belongs to the API; this is the bounded offline rendering boundary. */
+function validate(input:RenderInput){
+ if(!parseArrangement(input.arrangement)||!parseComposeSettings(input.settings))throw new Error('invalid-work');
+ if(!input.rules||Object.entries(RULE_VERSIONS).some(([key,value])=>input.rules[key as keyof typeof RULE_VERSIONS]!==value))throw new Error('renderer-incompatible');
+ const {inspiration,background}=input.settings;
+ if(inspiration.kind==='teaching-music')throw new Error('not-open');
+ if(input.textbook&&(!isTextbookTrack(input.textbook)||!Number.isFinite(input.textbook.tempoBpm)))throw new Error('invalid-textbook');
+ if(inspiration.kind==='textbook'&&input.textbook?.id!==inspiration.entryId)throw new Error('missing-textbook');
+ if(background.instruments.some(id=>!LOCAL_INSTRUMENTS.some(instrument=>instrument.id===id)))throw new Error('unknown-instrument');
+ if(!input.arrangement.events.length)throw new Error('empty-work');
+ if(input.sourceLimits&&Object.values(input.sourceLimits).some(value=>!Number.isFinite(value)||value<45.5||value>60))throw new Error('invalid-source-limit');
+ if(input.sourceFacts){const ids=new Set(input.arrangement.units.map(unit=>unit.sourceId));
+  if(Object.keys(input.sourceFacts).length!==ids.size||[...ids].some(id=>{
+   const fact=input.sourceFacts![id];return !fact||!/^[a-f0-9]{64}$/.test(fact.checksum)||!isSoundAnalysis(fact.analysis)||fact.analysis.rules!==RULE_VERSIONS.analysis
+    ||fact.analysis.durationMs>(input.sourceLimits?.[id]??45.5)*1000;
+  }))throw new Error('invalid-source-facts');
+ }
+}
+
+const checkBuffer=(buffer:AudioBuffer,limit=45.5)=>{
+ if(buffer.sampleRate!==RENDER_SAMPLE_RATE||buffer.numberOfChannels<1||buffer.numberOfChannels>2
+  ||buffer.duration<=0||buffer.duration>limit)throw new Error('invalid-source');
+};
+
+/** Build canonical timing from actual samples, never from client-supplied analysis. Choices and positions stay intact. */
+async function canonicalArrangement(input:RenderInput,load:SourceLoader,release:()=>void|Promise<void>):Promise<Arrangement>{
+ const {arrangement,sourceLimits:limits={},sourceFacts:facts}=input;
+ const analyses=new Map<string,ReturnType<typeof analyseSamples>>();
+ for(const id of new Set(arrangement.units.map(unit=>unit.sourceId))){
+  if(facts){analyses.set(id,facts[id]!.analysis);continue;}
+  const buffer=await load(id);checkBuffer(buffer,limits[id]);
+  analyses.set(id,analyseSamples(Array.from({length:buffer.numberOfChannels},(_,i)=>buffer.getChannelData(i)),buffer.sampleRate));
+  await release();
+ }
+ const result={...arrangement,units:arrangement.units.map(unit=>({...unit,analysis:analyses.get(unit.sourceId)!}))};
+ for(const item of planPlayback(result))if(item.clip.endMs>analyses.get(item.sourceId)!.durationMs)throw new Error('invalid-source-clip');
+ return result;
+}
+
+/** One clip at a time into one accumulator: memory does not grow with the number of placed events. */
+export async function renderWork(input:RenderInput,load:SourceLoader,release:()=>void|Promise<void>=()=>{}):Promise<AudioBuffer>{
+ validate(input);
+ const arrangement=await canonicalArrangement(input,load,release),seconds=pieceSeconds(arrangement);
+ if(seconds>90)throw new Error('work-too-long');
+ const frames=Math.ceil(seconds*RENDER_SAMPLE_RATE),ctx=new OfflineAudioContext(2,frames,RENDER_SAMPLE_RATE);
+ const sum=ctx.createBuffer(2,frames,RENDER_SAMPLE_RATE);
+ const groups=new Map<string,ReturnType<typeof planPlayback>>();
+ for(const item of planPlayback(arrangement)){
+  const key=JSON.stringify([item.sourceId,shapeKey(item.shape),item.clip.startMs,item.clip.endMs]);
+  const group=groups.get(key);if(group)group.push(item);else groups.set(key,[item]);
+ }
+ const accumulate=async(group:ReturnType<typeof planPlayback>)=>{
+  const item=group[0]!;
+  const source=await load(item.sourceId);checkBuffer(source,input.sourceLimits?.[item.sourceId]);
+  if(input.sourceFacts&&Math.abs(source.duration*1000-input.sourceFacts[item.sourceId]!.analysis.durationMs)>.5)throw new Error('source-facts-mismatch');
+  const shaped=await renderShaped(source,planClip(item.shape,item.clip,item.analysis,item.sourceId));
+  // Repeated identical clips are rendered once, accumulated at each original position, then released.
+  for(const placement of group){
+   const offset=Math.round(placement.startSeconds*RENDER_SAMPLE_RATE),length=Math.min(shaped.length,frames-offset);
+   for(let c=0;c<2;c++){
+    const into=sum.getChannelData(c),from=shaped.getChannelData(Math.min(c,shaped.numberOfChannels-1));
+    for(let i=0;i<length;i++)into[offset+i]=into[offset+i]!+from[i]!;
+   }
+  }
+ };
+ for(const group of groups.values()){await accumulate(group);await release();}
+ const master=ctx.createGain();master.gain.value=MIX_RULES.childGain;
+ const limiter=ctx.createDynamicsCompressor(),rules=MIX_RULES.limiter;
+ limiter.threshold.value=rules.thresholdDb;limiter.knee.value=rules.kneeDb;limiter.ratio.value=rules.ratio;
+ limiter.attack.value=rules.attackSeconds;limiter.release.value=rules.releaseSeconds;
+ master.connect(limiter).connect(ctx.destination);
+ const child=ctx.createBufferSource();child.buffer=sum;child.connect(master);child.start(0);
+ const {background,inspiration}=input.settings;
+ if(background.enabled&&background.volume>0){
+  const mood=arrangement.mood;
+  const plan=backgroundPlan({seconds,seed:arrangement.id,sounding:timedEvents(arrangement).map(({start,end})=>({start,end})),
+   mood:mood?.kind==='preset'?mood.id:mood?.kind==='custom'?mood.nearest:null,
+   textbook:inspiration.kind==='textbook'&&input.textbook?{...input.textbook,variation:inspiration.variation??'original'}:null});
+  const chosen=background.instruments.map(id=>LOCAL_INSTRUMENTS.find(instrument=>instrument.id===id)!);
+  const under=await renderBackground(plan,assignParts(chosen),Object.fromEntries(chosen.map(instrument=>[instrument.id,instrument.recipe])));
+  const node=ctx.createBufferSource(),gain=ctx.createGain();node.buffer=under;
+  gain.gain.value=background.volume*MIX_RULES.backgroundMaxGain;node.connect(gain).connect(master);node.start(0);
+ }
+ return ctx.startRendering();
+}
diff --git a/packages/audio-engine/src/shaping.ts b/packages/audio-engine/src/shaping.ts
new file mode 100644
index 0000000000000000000000000000000000000000..aa4c0b8162f5779c15bdd8717866e4aa09e72e03
--- /dev/null
+++ b/packages/audio-engine/src/shaping.ts
@@ -0,0 +1,56 @@
+// Turns a shaping plan (from @wanwu-v2/sound-rules) into a new buffer, offline. The source buffer is only read, never
+// modified. This file holds no sound rules — every number comes from the plan, i.e. from the rule files.
+import type {PlanEvent,ShapingPlan} from '@wanwu-v2/sound-rules/shaping';
+import {scheduleGrains} from './grains.ts';
+
+type OfflineConstructor=typeof OfflineAudioContext;
+const SHELF_HZ=3000;
+const toGain=(db:number)=>10**(db/20);
+
+/** Level over one event: a swell (wave, gust) or attack → hold → release; never a hard stop. */
+function envelope(gain:AudioParam,event:PlanEvent){
+ const start=event.at,end=event.at+event.length;
+ gain.setValueAtTime(0,start);
+ if(event.swell){gain.linearRampToValueAtTime(1,start+event.length*.4);gain.setValueAtTime(1,start+event.length*.55);gain.linearRampToValueAtTime(0,end);return;}
+ const attack=Math.min(event.attackSeconds,event.length/2),release=Math.min(event.releaseSeconds,event.length-attack);
+ gain.linearRampToValueAtTime(1,start+attack);gain.setValueAtTime(1,Math.max(start+attack,end-release));gain.linearRampToValueAtTime(0,end);
+}
+
+function playEvent(ctx:BaseAudioContext,source:AudioBuffer,plan:ShapingPlan,event:PlanEvent,bus:AudioNode){
+ const level=ctx.createGain();level.connect(bus);
+ if(event.rampDb){level.gain.setValueAtTime(event.gain*toGain(event.rampDb[0]),event.at);level.gain.linearRampToValueAtTime(event.gain*toGain(event.rampDb[1]),event.at+event.length);}
+ else level.gain.value=event.gain;
+ const shape=ctx.createGain();shape.gain.value=0;envelope(shape.gain,event);
+ let last:AudioNode=shape;
+ if(plan.wave?.gainDepth){
+  // 有起伏 also breathes in level, at the same pace as the pitch.
+  const breathe=ctx.createGain(),lfo=ctx.createOscillator(),depth=ctx.createGain();
+  breathe.gain.value=1-plan.wave.gainDepth/2;lfo.frequency.value=plan.wave.rateHz;depth.gain.value=plan.wave.gainDepth/2;
+  lfo.connect(depth).connect(breathe.gain);lfo.start(event.at);lfo.stop(event.at+event.length);
+  shape.connect(breathe);last=breathe;
+ }
+ last.connect(level);
+ let input:AudioNode=shape;
+ if(event.sweep){
+  const filter=ctx.createBiquadFilter();filter.type='lowpass';filter.Q.value=.7;
+  filter.frequency.setValueAtTime(event.sweep.fromHz,event.at);
+  filter.frequency.exponentialRampToValueAtTime(event.sweep.toHz,event.at+Math.max(.01,event.length*event.sweep.portion));
+  filter.connect(shape);input=filter;
+ }
+ if(plan.grainSeconds){scheduleGrains(ctx,source,plan,event,input);return;}
+ const node=ctx.createBufferSource();node.buffer=source;node.connect(input);
+ node.start(event.at,Math.min(Math.max(0,event.from),Math.max(0,source.duration-.001)));node.stop(event.at+event.length);
+}
+
+export async function renderShaped(source:AudioBuffer,plan:ShapingPlan):Promise<AudioBuffer>{
+ const Offline=window.OfflineAudioContext||(window as unknown as {webkitOfflineAudioContext:OfflineConstructor}).webkitOfflineAudioContext;
+ const sampleRate=source.sampleRate,total=Math.max(.05,plan.totalSeconds);
+ const ctx=new Offline(source.numberOfChannels,Math.ceil((total+.02)*sampleRate),sampleRate);
+ // Shared tone for the whole sound: level → high shelf (brighter / darker) → low-pass (softer) → out.
+ const bus=ctx.createGain();bus.gain.value=plan.gain;
+ const shelf=ctx.createBiquadFilter();shelf.type='highshelf';shelf.frequency.value=SHELF_HZ;shelf.gain.value=plan.highShelfDb;
+ const lowpass=ctx.createBiquadFilter();lowpass.type='lowpass';lowpass.Q.value=.7;lowpass.frequency.value=Math.min(plan.lowpassHz,sampleRate/2-100);
+ bus.connect(shelf).connect(lowpass).connect(ctx.destination);
+ for(const event of plan.events)playEvent(ctx,source,plan,event,bus);
+ return ctx.startRendering();
+}
diff --git a/packages/audio-engine/src/timeline.ts b/packages/audio-engine/src/timeline.ts
new file mode 100644
index 0000000000000000000000000000000000000000..67a173b32e0c8caf48035e11e5ac45d3543a2e73
--- /dev/null
+++ b/packages/audio-engine/src/timeline.ts
@@ -0,0 +1,31 @@
+import {eventsInOrder} from '@wanwu-v2/contracts/arrangement';
+import type {Arrangement,PlacedEvent,SourceClip} from '@wanwu-v2/contracts/arrangement';
+import type {ChosenShape,SoundAnalysis,SoundUnitDraft} from '@wanwu-v2/contracts/sound';
+import {clipHeardSeconds} from '@wanwu-v2/sound-rules/shaping';
+
+export function heardSeconds(unit:Pick<SoundUnitDraft,'shape'|'analysis'>,event:Pick<PlacedEvent,'clip'>){
+ return clipHeardSeconds(unit.shape,unit.analysis??null,event.clip);
+}
+export function unitOf(arrangement:Arrangement|null,unitId:string){return arrangement?.units.find(unit=>unit.id===unitId)??null;}
+
+export type PlannedEvent={eventId:string;unitId:string;sourceId:string;startSeconds:number;clip:SourceClip;shape:ChosenShape;analysis:SoundAnalysis|null};
+export function planPlayback(arrangement:Arrangement):PlannedEvent[]{
+ return eventsInOrder(arrangement.events).flatMap(event=>{
+  const unit=unitOf(arrangement,event.unitId);
+  return unit?[{eventId:event.id,unitId:unit.id,sourceId:unit.sourceId,startSeconds:event.at*arrangement.spanSeconds,clip:event.clip,shape:unit.shape,analysis:unit.analysis??null}]:[];
+ });
+}
+
+export type TimedEvent={event:PlacedEvent;unit:SoundUnitDraft;start:number;seconds:number;end:number};
+export function timedEvents(arrangement:Arrangement):TimedEvent[]{
+ return eventsInOrder(arrangement.events).flatMap(event=>{
+  const unit=unitOf(arrangement,event.unitId);if(!unit)return [];
+  const start=event.at*arrangement.spanSeconds,seconds=heardSeconds(unit,event);
+  return [{event,unit,start,seconds,end:start+seconds}];
+ });
+}
+/** Preserve the last sound, including one starting at the right edge of a 45-second field. */
+export function pieceSeconds(arrangement:Arrangement){
+ const last=Math.max(0,...timedEvents(arrangement).map(item=>item.end));
+ return Math.max(arrangement.spanSeconds,Math.ceil(last*10-1e-6)/10);
+}
