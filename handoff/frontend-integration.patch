index 0000000000000000000000000000000000000000..31f14d487dc2263362568bd32393922a091f5e22
--- /dev/null
+++ b/apps/web/src/shared/cloud/CloudToolbar.tsx
@@ -0,0 +1,58 @@
+import {useEffect,useState} from 'react';
+import {WorkSheet} from '../ui/WorkSheet';
+import {useAccount} from '../account/AccountProvider';
+import {useCloud} from './CloudProvider';
+import {cloudError} from './cloudTypes';
+import {ShareDialog} from './ShareDialog';
+import {LibraryManager} from './LibraryManager';
+import styles from './CloudControls.module.css';
+
+export function CloudToolbar({onNavigate}:{onNavigate:(path:string)=>void}){
+ const cloud=useCloud(),{workspace}=cloud,{account}=useAccount();
+ const [confirm,setConfirm]=useState<{title:string;message:string;action:()=>Promise<unknown>|void}|null>(null);
+ const [title,setTitle]=useState(cloud.title),[error,setError]=useState('');
+ useEffect(()=>{setTitle(cloud.title);},[cloud.title]);
+ useEffect(()=>{setConfirm(null);setError('');},[cloud.accountId]);
+ const act=async(action:()=>Promise<unknown>|void)=>{setError('');try{await action();}catch(caught){setError(cloudError(caught));}};
+ if(!account)return null;
+ const choose=(title:string,message:string,action:()=>Promise<unknown>|void)=>{workspace.update({dialog:null});setConfirm({title,message,action});};
+ return <>
+  <aside className={styles.bar} aria-label="云端创作">
+   <div className={styles.row}><p role="status">{cloud.workId?`${cloud.title} · `:''}{cloud.message}</p>
+    <div className={styles.actions}>
+     {!cloud.workId?<button type="button" className={styles.primary} disabled={cloud.busy} onClick={()=>choose('保存到我的账号','将当前已完成的声音与编排保存为独立云端草稿；会上传原件，但不会自动加入任何素材库或发布。尚未点「做好了」的声卡不在编排里。',()=>workspace.attach())}>确认保存当前云草稿</button>:
+      <button type="button" className={styles.button} disabled={cloud.busy} onClick={()=>void act(()=>workspace.flush())}>立即同步</button>}
+     <button type="button" className={styles.button} disabled={cloud.busy} onClick={()=>choose('新建独立云草稿','新草稿不会删除已有云端作品。当前页面尚未完成的声卡不会自动带入，请先完成它或确认离开。',async()=>{await workspace.freshDraft();onNavigate('/create?new');})}>新建云草稿</button>
+     <button type="button" className={styles.button} onClick={()=>{workspace.update({dialog:'drafts'});void act(()=>workspace.refreshDrafts());}}>选择草稿</button>
+     <button type="button" className={styles.button} onClick={()=>onNavigate('/works')}>账号书架</button>
+     <button type="button" className={styles.button} onClick={()=>workspace.update({dialog:'library'})}>个人／共享库</button>
+     {cloud.workId&&<button type="button" className={styles.button} onClick={()=>workspace.update({dialog:'share'})}>作品分享</button>}
+     {account.role==='admin'&&<button type="button" className={styles.button} onClick={()=>onNavigate('/admin')}>管理</button>}
+    </div>
+   </div>
+   {cloud.recoverable&&<button type="button" className={styles.button} onClick={()=>choose('恢复本页暂存','将恢复这个账号上次留在本页内存的作品，替换当前编辑画面。请确认当前新内容已经保存。',()=>{workspace.recover();onNavigate('/world');})}>恢复本页暂存</button>}
+   {cloud.phase==='conflict'&&<div className={styles.actions}>
+    <button type="button" className={styles.button} disabled={cloud.busy} onClick={()=>choose('重新加载云端','这会丢弃本页尚未保存的修改。若要保留，请先选择另存副本。',()=>workspace.open((cloud.workId??cloud.conflictId)!))}>重新加载</button>
+    <button type="button" className={styles.button} disabled={cloud.busy} onClick={()=>void act(()=>workspace.attach(true))}>另存独立副本</button>
+   </div>}
+   {error&&<p className={styles.error} role="alert">{error}</p>}
+  </aside>
+  {confirm&&<WorkSheet title={confirm.title} onClose={()=>setConfirm(null)}><p>{confirm.message}</p><div className={styles.actions}>
+   <button type="button" className={styles.button} onClick={()=>setConfirm(null)}>返回继续编辑</button>
+   <button type="button" className={styles.primary} disabled={cloud.busy} onClick={()=>{const action=confirm.action;setConfirm(null);void act(action);}}>确认继续</button>
+  </div></WorkSheet>}
+  {cloud.dialog==='drafts'&&<WorkSheet title="我的云端草稿" onClose={()=>workspace.update({dialog:null})}>
+   <p className={styles.hint}>草稿按作品独立保存，不改变其他设备当前打开哪一份。</p>
+   {cloud.workId&&<form className={styles.form} onSubmit={event=>{event.preventDefault();void act(()=>workspace.rename(title));}}>
+    <label>当前草稿名称<input value={title} maxLength={16} onChange={event=>setTitle(event.target.value)}/></label>
+    <button className={styles.button} type="submit" disabled={cloud.busy}>保存名称</button>
+   </form>}
+   <ul className={styles.list}>{cloud.drafts.map(work=><li key={work.id}><p>{work.title} · 修订 {work.revision}</p><small>{new Date(work.updatedAt).toLocaleString('zh-CN')}</small>
+    <button type="button" className={styles.button} disabled={cloud.busy} onClick={()=>choose('打开这份云草稿','请先同步当前修改；打开后会替换当前编辑画面。保存失败或有冲突时，可以先返回另存副本。',async()=>{await workspace.open(work.id);onNavigate('/world');})}>打开草稿</button>
+   </li>)}</ul>
+   {!cloud.drafts.length&&<p className={styles.hint}>当前没有未完成的云端草稿；已正式保存的作品在账号书架。</p>}
+  </WorkSheet>}
+  {cloud.dialog==='share'&&<ShareDialog onClose={()=>workspace.update({dialog:null})}/>}
+  {cloud.dialog==='library'&&<LibraryManager onClose={()=>workspace.update({dialog:null})}/>}
+ </>;
+}
diff --git a/apps/web/src/shared/cloud/LibraryAudio.tsx b/apps/web/src/shared/cloud/LibraryAudio.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..dd5d4d30c9007d7a1bb3cc0bb355a35cc768a98c
--- /dev/null
+++ b/apps/web/src/shared/cloud/LibraryAudio.tsx
@@ -0,0 +1,34 @@
+import {useEffect,useRef,useState} from 'react';
+import type {SourceView} from '@wanwu-v2/contracts/cloud';
+import type {SoundUnitDraft} from '@wanwu-v2/contracts/sound';
+import {planCard} from '@wanwu-v2/sound-rules/shaping';
+import {renderShaped} from '@wanwu-v2/audio-engine/shaping';
+import {pcm16Wave} from '@wanwu-v2/audio-engine/pcm';
+import type {CloudMedia} from './cloudMedia';
+import {cloudError} from './cloudTypes';
+import styles from './CloudControls.module.css';
+
+/** Confirmation hears the same canonical derivative, rules and five-dimensional parameters as the editor. */
+export function LibraryAudio({view,unit,media,onPlay,onReset}:{view:SourceView;unit?:SoundUnitDraft|null;media:CloudMedia;onPlay?:()=>void;onReset?:()=>void}){
+ const [url,setUrl]=useState(''),[error,setError]=useState(''),[retry,setRetry]=useState(0);
+ const reset=useRef(onReset);reset.current=onReset;
+ const parameters=unit?JSON.stringify({id:unit.id,shape:unit.shape}):'';
+ useEffect(()=>{
+  let live=true,objectUrl:string|undefined;setUrl('');setError('');reset.current?.();
+  const prepare=async()=>{
+   if(!unit){const fresh=retry?await media.source(view.source.id):view;if(live)setUrl(fresh.playback?.url??'');return;}
+   const {buffer,view:canonical}=await media.load(view.source.id);
+   if(!canonical.analysis)throw new Error('缺少服务端声音体检，不能确认这张声卡。');
+   const rendered=await renderShaped(buffer,planCard(unit.shape,canonical.analysis,unit.id));
+   const channels=Array.from({length:rendered.numberOfChannels},(_,index)=>rendered.getChannelData(index));
+   objectUrl=URL.createObjectURL(new Blob([pcm16Wave(channels,rendered.sampleRate)],{type:'audio/wav'}));
+   if(live)setUrl(objectUrl);else URL.revokeObjectURL(objectUrl);
+  };
+  void prepare().catch(caught=>{if(live)setError(cloudError(caught));});
+  return()=>{live=false;if(objectUrl)URL.revokeObjectURL(objectUrl);};
+ },[view.source.id,view.playback?.url,parameters,media,retry]);
+ return <div><p className={styles.hint}>{unit?'试听当前声卡与五维选择':'试听音源原声'}</p>
+  {url?<audio className={styles.audio} controls preload="none" src={url} onPlay={onPlay} onError={()=>{if(!retry)setRetry(1);else setError('试听暂时失败，请关闭后重试。');}}/>:<p role="status">{error||'正在准备试听…'}</p>}
+  {url&&error&&<p role="alert" className={styles.error}>{error}</p>}
+ </div>;
+}
diff --git a/apps/web/src/shared/cloud/LibraryManager.tsx b/apps/web/src/shared/cloud/LibraryManager.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..5d9ae649342e82b48d2f7f06e7280ab5db83a12c
--- /dev/null
+++ b/apps/web/src/shared/cloud/LibraryManager.tsx
@@ -0,0 +1,75 @@
+import {useEffect,useState,useSyncExternalStore} from 'react';
+import type {LibraryEntry,SourceView} from '@wanwu-v2/contracts/cloud';
+import {CONFIRMATION_VERSION} from '@wanwu-v2/contracts/cloud';
+import type {SoundUnitDraft} from '@wanwu-v2/contracts/sound';
+import {WorkSheet} from '../ui/WorkSheet';
+import {workSession} from '../creation/workSession';
+import {sessionArchive} from '../creation/sourceArchive';
+import {newId} from '../creation/ids';
+import {useCloud} from './CloudProvider';
+import {cloudError} from './cloudTypes';
+import {LibraryAudio} from './LibraryAudio';
+import {libraryEntries} from './libraryEntries';
+import styles from './CloudControls.module.css';
+
+export function LibraryManager({onClose}:{onClose:()=>void}){
+ const {workspace}=useCloud(),arrangement=useSyncExternalStore(workSession.subscribe,workSession.current);
+ const archive=useSyncExternalStore(sessionArchive.subscribe,sessionArchive.list);
+ const [entries,setEntries]=useState<LibraryEntry[]>([]),[sourceId,setSourceId]=useState(''),[scope,setScope]=useState<'private'|'teachers'>('private');
+ const [kind,setKind]=useState<'source'|'sound-unit'>('source'),[ready,setReady]=useState<SourceView|null>(null),[editing,setEditing]=useState<LibraryEntry|null>(null);
+ const [listened,setListened]=useState(false),[confirmed,setConfirmed]=useState(false),[busy,setBusy]=useState(false),[error,setError]=useState(''),[message,setMessage]=useState(''),[removing,setRemoving]=useState<string|null>(null);
+ const [preview,setPreview]=useState<string|null>(null);
+ const choices=[...new Set([...(arrangement?.units.map(unit=>unit.sourceId)??[]),...archive.map(source=>source.id)])];
+ const refresh=async()=>{
+  const account=workspace.state.accountId;
+  const results=await Promise.all((['sources','sound-units'] as const).flatMap(path=>(['mine','teachers'] as const).map(scope=>libraryEntries(workspace.api,path,scope))));
+  if(account===workspace.state.accountId)setEntries([...new Map(results.flat().map(entry=>[entry.entryId,entry])).values()]);
+ };
+ useEffect(()=>{let live=true;void refresh().catch(caught=>{if(live)setError(cloudError(caught));});return()=>{live=false;};},[workspace]);
+ const act=async(action:()=>Promise<void>)=>{if(busy)return;setBusy(true);setError('');setMessage('');try{await action();}catch(caught){setError(cloudError(caught));}finally{setBusy(false);}};
+ const prepare=async()=>{
+  if(!sourceId)throw new Error('请先选择本页的一个声音。');
+  const unit:SoundUnitDraft=arrangement?.units.find(item=>item.sourceId===sourceId)??{version:'sound-v1',id:newId('unit'),sourceId,name:'声音',maker:null,markerIndex:0,shape:{},input:'manual',createdAt:new Date().toISOString()};
+  const draft=arrangement??{version:'arrangement-v1',id:newId('work'),units:[],events:[],rows:3,spanSeconds:30,mood:null,origin:'child',updatedAt:new Date().toISOString()};
+  const result=await workspace.media.prepare({...draft,units:[unit]},setMessage);setReady(result.get(sourceId)!);setListened(false);setConfirmed(false);
+ };
+ const submit=async()=>{
+  if(!ready||!confirmed||!listened)throw new Error('请先准备并试听这份音频，再勾选确认。');
+  const unit=editing?.unit??arrangement?.units.find(item=>item.sourceId===ready.source.id);
+  if(kind==='sound-unit'&&!unit)throw new Error('声卡入库需要先在当前作品中完成这张声卡。');
+  const proof={listened:true,suitableForChildren:true,statementVersion:CONFIRMATION_VERSION};
+  if(editing)await workspace.api.business(`/api/v1/library/entries/${editing.entryId}`,'PATCH',{scope,...(kind==='sound-unit'?{unit}:{}),confirmation:proof});
+  else await workspace.api.business('/api/v1/library/entries','POST',{sourceId:ready.source.id,kind,scope,...(kind==='sound-unit'?{unit}:{}),confirmation:proof});
+  setMessage('已按本次试听确认加入选定素材库。上传本身不会自动入库。');setReady(null);setEditing(null);setConfirmed(false);setListened(false);await refresh();
+ };
+ return <WorkSheet title="个人与老师共享素材库" description="两种素材库都需要老师试听确认。这里没有付费机器审核，也不代表平台逐条审核。" onClose={onClose}>
+  <form className={styles.form} onSubmit={event=>{event.preventDefault();void act(submit);}}>
+   <label>准备入库的本页声音<select value={sourceId} disabled={busy||!!editing} onChange={event=>{setSourceId(event.target.value);setReady(null);setListened(false);setConfirmed(false);}}>
+    <option value="">请选择声音</option>{choices.map(id=><option key={id} value={id}>{workSession.source(id)?.label??archive.find(source=>source.id===id)?.label??id}</option>)}
+   </select></label>
+   <div className={styles.actions}><button className={styles.button} type="button" disabled={busy||!sourceId||!!editing} onClick={()=>void act(prepare)}>上传／准备试听（不入库）</button></div>
+   <label>保存内容<select value={kind} disabled={busy||!!editing} onChange={event=>{setKind(event.target.value as 'source'|'sound-unit');setConfirmed(false);setListened(false);}}><option value="source">音源原声</option><option value="sound-unit">当前声卡与五维选择</option></select></label>
+   <label>素材范围<select value={scope} disabled={busy} onChange={event=>{setScope(event.target.value as 'private'|'teachers');setConfirmed(false);}}><option value="private">个人素材库</option><option value="teachers">受邀老师共享库</option></select></label>
+   {ready?.playback&&<><p className={styles.hint}>试听：{ready.source.label} · {Math.round(ready.source.durationMs/100)/10} 秒</p>
+    <LibraryAudio view={ready} unit={kind==='sound-unit'?editing?.unit??arrangement?.units.find(unit=>unit.sourceId===ready.source.id):null} media={workspace.media} onPlay={()=>setListened(true)} onReset={()=>{setListened(false);setConfirmed(false);}}/></>}
+   <label className={styles.check}><input type="checkbox" checked={confirmed} disabled={busy} onChange={event=>setConfirmed(event.target.checked)}/>我已试听本次声音，确认适合儿童，且有权按所选范围提供该内容。声卡入库也包含本次五维参数。</label>
+   <button className={styles.primary} type="submit" disabled={busy||!ready||!confirmed||!listened}>{editing?'重新确认并更新条目':'确认加入选定素材库'}</button>
+   {editing&&<button type="button" className={styles.button} onClick={()=>{setEditing(null);setReady(null);}}>取消修改</button>}
+  </form>
+  {message&&<p className={styles.status} role="status">{message}</p>}{error&&<p className={styles.error} role="alert">{error}</p>}
+  {removing&&<div className={styles.card}><p>移除后停止通过此条目新增引用；已合法保存的作品仍保留音频。</p><div className={styles.actions}>
+   <button type="button" className={styles.button} onClick={()=>setRemoving(null)}>取消移除</button>
+   <button type="button" className={styles.primary} disabled={busy} onClick={()=>void act(async()=>{await workspace.api.business(`/api/v1/library/entries/${removing}`,'DELETE');setRemoving(null);await refresh();})}>确认移除条目</button>
+  </div></div>}
+  <ul className={styles.list}>{entries.map(entry=><li key={entry.entryId}>
+   <p>{entry.unit?.name??entry.source.source.label} · {entry.scope==='private'?'个人':'老师共享'} · {entry.kind==='source'?'音源':'声卡'}</p>
+   <small>确认时间：{new Date(entry.confirmation.confirmedAt).toLocaleString('zh-CN')} · 音源 ID：{entry.sourceId}</small>
+   {preview===entry.entryId?<LibraryAudio view={entry.source} unit={entry.unit} media={workspace.media}/>:<button type="button" className={styles.button} onClick={()=>setPreview(entry.entryId)}>试听{entry.kind==='sound-unit'?'声卡':'原声'}</button>}
+   {entry.mine&&<div className={styles.actions}>
+    <button type="button" className={styles.button} disabled={busy} onClick={()=>void act(async()=>{setSourceId(entry.sourceId);setKind(entry.kind);setScope(entry.scope==='private'?'teachers':'private');setEditing(entry);setReady(await workspace.media.source(entry.sourceId));setConfirmed(false);setListened(false);})}>修改范围（重新确认）</button>
+    <button type="button" className={styles.button} disabled={busy} onClick={()=>setRemoving(entry.entryId)}>移除条目</button>
+   </div>}
+  </li>)}</ul>
+  {!entries.length&&<p className={styles.hint}>没有已确认的素材条目。仅上传的声音不会列入这里。</p>}
+ </WorkSheet>;
+}
diff --git a/apps/web/src/shared/cloud/PublicSharePage.tsx b/apps/web/src/shared/cloud/PublicSharePage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..07eb55ca3c9994e936057c4bdc9f190ebaa83191
--- /dev/null
+++ b/apps/web/src/shared/cloud/PublicSharePage.tsx
@@ -0,0 +1,34 @@
+import {useEffect,useRef,useState} from 'react';
+import {parsePublishedWork} from '@wanwu-v2/contracts/cloud';
+import type {PublishedWorkView} from '@wanwu-v2/contracts/cloud';
+import styles from './CloudControls.module.css';
+
+export function PublicSharePage({token}:{token:string}){
+ const [view,setView]=useState<PublishedWorkView|null>(null),[message,setMessage]=useState('正在打开作品…'),[busy,setBusy]=useState(false);
+ const audio=useRef<HTMLAudioElement>(null),sequence=useRef(0),retrying=useRef(false),automaticRetry=useRef(false);
+ const load=async()=>{
+  const request=++sequence.current;
+  setBusy(true);try{
+   const response=await fetch(`/api/v1/shares/${encodeURIComponent(token)}`,{credentials:'omit',cache:'no-store',redirect:'error',signal:AbortSignal.timeout(20_000)});
+   if(!response.ok)throw new Error(response.status===404?'链接不存在或已撤销。':'作品服务暂时不可用，请稍后重试。');
+   const result=parsePublishedWork(await response.json());if(!result)throw new Error('作品信息返回异常。');
+   if(request!==sequence.current)return null;setView(result);setMessage('这是老师确认发布的成品。无需登录即可播放。');return result;
+  }catch(error){if(request===sequence.current){setView(null);setMessage(error instanceof Error?error.message:'打开失败，请稍后重试。');}return null;}
+  finally{if(request===sequence.current)setBusy(false);}
+ };
+ useEffect(()=>{automaticRetry.current=false;setView(null);void load();return()=>{++sequence.current;};},[token]);
+ const refreshPlayback=async()=>{
+  if(retrying.current)return;retrying.current=true;const at=audio.current?.currentTime??0,playing=!!audio.current&&!audio.current.paused;
+  try{const next=await load();if(next&&audio.current){audio.current.src=next.audio.playback.url;audio.current.currentTime=at;if(playing)await audio.current.play().catch(()=>{});}}
+  finally{retrying.current=false;}
+ };
+ return <main className={styles.page}><section className={styles.card} aria-label="公开作品">
+  <h1>{view?.title??'万物声谱 · 分享作品'}</h1><p role="status">{message}</p>
+  {view&&<><p className={styles.hint}>发布时间：{new Date(view.publishedAt).toLocaleString('zh-CN')}</p>
+   <audio className={styles.audio} ref={audio} controls preload="none" src={view.audio.playback.url} onError={()=>{if(!automaticRetry.current){automaticRetry.current=true;void refreshPlayback();}else setMessage('音频暂时无法播放，请稍后手动重试。');}}
+    onPlay={()=>{if(Date.parse(view.audio.playback.expiresAt)<Date.now()+5000)void refreshPlayback();}}/>
+   <p className={styles.hint}>播放地址短时有效。此页面不提供老师账号、采集地点、原始素材或作品编辑权限。</p>
+  </>}
+  <button type="button" className={styles.button} disabled={busy} onClick={()=>{automaticRetry.current=false;void load();}}>重新获取播放授权</button>
+ </section></main>;
+}
diff --git a/apps/web/src/shared/cloud/ShareDialog.tsx b/apps/web/src/shared/cloud/ShareDialog.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..d096e40d2ac17de6a4a33b5a8e0845f1529dc6df
--- /dev/null
+++ b/apps/web/src/shared/cloud/ShareDialog.tsx
@@ -0,0 +1,39 @@
+import {useEffect,useRef,useState} from 'react';
+import {WorkSheet} from '../ui/WorkSheet';
+import {useCloud} from './CloudProvider';
+import {cloudError} from './cloudTypes';
+import styles from './CloudControls.module.css';
+
+export function ShareDialog({onClose}:{onClose:()=>void}){
+ const {workspace,render,share,busy}=useCloud(),[listened,setListened]=useState(false),[confirmed,setConfirmed]=useState(false),[error,setError]=useState('');
+ const retried=useRef(false),revision=workspace.record?.savedRevision;
+ useEffect(()=>{setListened(false);setConfirmed(false);retried.current=false;},[revision]);
+ useEffect(()=>{
+  let live=true,attempts=0,timer:ReturnType<typeof setTimeout>|undefined;
+  const refresh=async()=>{try{const next=await workspace.refreshRender();if(!live)return;await workspace.refreshShare();
+    if(live&&next&&next.status!=='ready'&&next.status!=='failed'&&++attempts<60)timer=setTimeout(()=>void refresh(),3000);
+   }catch(caught){if(live)setError(cloudError(caught));}};
+  void refresh();return()=>{live=false;clearTimeout(timer);};
+ },[workspace,revision]);
+ const act=async(action:()=>Promise<unknown>)=>{setError('');try{await action();}catch(caught){setError(cloudError(caught));}};
+ return <WorkSheet title="分享作品链接" description="只有再次确认发布，才会更新链接中的作品。编辑草稿不会自动发布。" onClose={onClose}>
+  {!workspace.record?.savedRevision?<p className={styles.hint}>请先在「万物成曲」正式保存到书架。云端草稿保存不等于生成成品。</p>:<>
+   <p className={styles.hint}>本次确认绑定书架修订 {workspace.record.savedRevision}。链接允许未登录的人打开，不会开放原始录音、地点或素材库。</p>
+   {render?.status==='ready'&&render.playback?<audio className={styles.audio} controls src={render.playback.url} onPlay={()=>setListened(true)} onError={()=>{if(!retried.current){retried.current=true;void act(()=>workspace.refreshRender());}else setError('成品暂时不能播放，请稍后重新打开分享窗口。');}}/>
+    :<p className={styles.status} role="status">{render?.status==='failed'?`成品生成失败：${render.failure??'请重试'}`:'成品正在后台生成，可以稍后再打开。'}</p>}
+   {render?.status==='failed'&&<button className={styles.button} type="button" disabled={busy} onClick={()=>void act(()=>workspace.retryRender())}>重试成品生成</button>}
+   <form className={styles.form} onSubmit={event=>{event.preventDefault();void act(()=>workspace.publish());}}>
+    <label className={styles.check}><input type="checkbox" checked={confirmed} onChange={event=>setConfirmed(event.target.checked)}/>我已试听本次成品，确认适合儿童，并同意允许任何持链接者播放。</label>
+    <button className={styles.primary} type="submit" disabled={busy||!confirmed||!listened||render?.status!=='ready'}>确认发布此修订</button>
+   </form>
+  </>}
+  {share?.status==='pending-render'&&<p role="status">等待已确认修订的成品生成，不是等待审核。</p>}
+  {share?.status==='published'&&share.url&&<>
+   <p className={styles.status}>已发布修订 {share.workRevision}。不会自动进入公开广场。</p>
+   <a className={styles.link} href={share.url} target="_blank" rel="noopener noreferrer">{share.url}</a>
+   <button className={styles.button} type="button" disabled={busy} onClick={()=>void act(()=>workspace.revoke())}>撤销分享链接</button>
+  </>}
+  {share?.status==='revoked'&&<p role="status">链接已撤销，不再签发新的播放地址。之前已下载或开始传输的音频不能收回。</p>}
+  {error&&<p role="alert" className={styles.error}>{error}</p>}
+ </WorkSheet>;
+}
diff --git a/apps/web/src/shared/cloud/adapters.ts b/apps/web/src/shared/cloud/adapters.ts
new file mode 100644
index 0000000000000000000000000000000000000000..28542e2b24fa6477a8eeb6581e81d8c9ac93e1b7
