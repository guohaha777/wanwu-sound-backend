@@ -0,0 +1,36 @@
+import {useId} from 'react';
+import type {useAccountForm} from './useAccountForm';
+import styles from './AccountDialog.module.css';
+
+export function AccountForm({form}:{form:ReturnType<typeof useAccountForm>}){
+ const id=useId(),{mode,draft,busy,update}=form;
+ const submitText=mode==='login'?'登录':mode==='register'?'注册并登录':mode==='change'?'更新密码并退出':'重置密码';
+ return <form className={styles.form} onSubmit={event=>{event.preventDefault();void form.submit();}} aria-busy={busy}>
+  <fieldset disabled={busy}>
+   {(mode==='login'||mode==='register')&&<>
+    <label htmlFor={`${id}-username`}>账号</label>
+    <input id={`${id}-username`} name="username" autoComplete="username" autoCapitalize="none" spellCheck={false} maxLength={32} value={draft.username} onChange={event=>update('username',event.target.value)} required aria-describedby={`${id}-username-hint`}/>
+    <p id={`${id}-username-hint`} className={styles.hint}>3–32 位英文字母、数字、下划线或短横线，不区分大小写。</p>
+   </>}
+   {mode==='register'&&<>
+    <label htmlFor={`${id}-invitation`}>邀请码</label>
+    <input id={`${id}-invitation`} name="invitationCode" autoComplete="off" autoCapitalize="none" spellCheck={false} value={draft.invitationCode} onChange={event=>update('invitationCode',event.target.value)} required/>
+    <p className={styles.hint}>仅限受邀老师注册；邀请码仅注册时使用。</p>
+   </>}
+   {mode==='change'&&<>
+    <label htmlFor={`${id}-old-password`}>当前密码</label>
+    <input id={`${id}-old-password`} name="oldPassword" type="password" autoComplete="current-password" value={draft.oldPassword} onChange={event=>update('oldPassword',event.target.value)} required/>
+   </>}
+   <label htmlFor={`${id}-password`}>{mode==='login'?'密码':'新密码'}</label>
+   <input id={`${id}-password`} name="password" type="password" autoComplete={mode==='login'?'current-password':'new-password'} value={draft.password} onChange={event=>update('password',event.target.value)} required aria-describedby={mode==='login'?undefined:`${id}-password-hint`}/>
+   {mode!=='login'&&<>
+    <p id={`${id}-password-hint`} className={styles.hint}>15–128 个字符，可用空格和中文；无需按“大小写＋符号”组合。</p>
+    <label htmlFor={`${id}-confirmation`}>再次填写新密码</label>
+    <input id={`${id}-confirmation`} name="confirmation" type="password" autoComplete="new-password" value={draft.confirmation} onChange={event=>update('confirmation',event.target.value)} required/>
+   </>}
+   {form.error&&<p className={styles.error} role="alert">{form.error}</p>}
+   <p className={styles.status} role="status">{form.message}</p>
+   <button className={styles.primary} type="submit">{busy?'正在处理…':submitText}</button>
+  </fieldset>
+ </form>;
+}
diff --git a/apps/web/src/shared/account/AccountProvider.tsx b/apps/web/src/shared/account/AccountProvider.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..f8217ff4d4508a2d684c002a384b3a412101ce28
--- /dev/null
+++ b/apps/web/src/shared/account/AccountProvider.tsx
@@ -0,0 +1,22 @@
+import {createContext,useContext,useEffect,useState,useSyncExternalStore} from 'react';
+import type {ReactNode} from 'react';
+import type {AccountClient} from './accountClient';
+import {AccountSession} from './accountSession';
+
+const Context=createContext<AccountSession|null>(null);
+export function AccountProvider({client,children}:{client:AccountClient;children:ReactNode}){
+ const [session]=useState(()=>new AccountSession(client));
+ useEffect(()=>{
+  void session.refresh();
+  const refresh=()=>{if(document.visibilityState==='visible')void session.refresh();};
+  const unsubscribe=client.onSessionInvalidation?.(()=>void session.refresh());
+  addEventListener('focus',refresh);document.addEventListener('visibilitychange',refresh);
+  return()=>{unsubscribe?.();removeEventListener('focus',refresh);document.removeEventListener('visibilitychange',refresh);};
+ },[session]);
+ return <Context.Provider value={session}>{children}</Context.Provider>;
+}
+export function useAccount(){
+ const session=useContext(Context);if(!session)throw new Error('AccountProvider is required');
+ const state=useSyncExternalStore(session.subscribe,session.getSnapshot,session.getSnapshot);
+ return {session,...state};
+}
diff --git a/apps/web/src/shared/account/ResetPasswordPage.tsx b/apps/web/src/shared/account/ResetPasswordPage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..bb150cc9cc2034fd4737f0f29f09015abbfc46af
--- /dev/null
+++ b/apps/web/src/shared/account/ResetPasswordPage.tsx
@@ -0,0 +1,37 @@
+import {useEffect,useRef,useState} from 'react';
+import {AccountForm} from './AccountForm';
+import {useAccountForm} from './useAccountForm';
+import {resetLinkToken} from './resetLink';
+import styles from './AccountDialog.module.css';
+
+export function ResetPasswordPage({onHome}:{onHome:()=>void}){
+ const consumed=useRef(false),[link,setLink]=useState<{ready:boolean;token:string|null;revision:number}>({ready:false,token:null,revision:0});
+ useEffect(()=>{
+  const read=()=>{
+   const token=resetLinkToken(location.hash);
+   // Retain the single-use secret only in component memory; strip it from the visible history entry.
+   history.replaceState(history.state,'',location.pathname+location.search);
+   setLink(previous=>({ready:true,token,revision:previous.revision+1}));
+  };
+  if(!consumed.current){consumed.current=true;read();}
+  // Opening another link to the same page is a fragment navigation, not a React remount.
+  addEventListener('hashchange',read);return()=>removeEventListener('hashchange',read);
+ },[]);
+ return <main className={styles.reset}><section className={styles.resetCard} aria-label="密码重置">
+  <h1>重置老师账号密码</h1>
+  <p className={styles.hint}>链接有效期 15 分钟，只能使用一次。更新后，所有旧设备都会退出登录。</p>
+  {!link.ready?<p role="status">正在读取链接…</p>:link.token?<ResetForm key={link.revision} token={link.token} onHome={onHome}/>:<>
+   <p className={styles.error} role="alert">重置链接缺失或无效，请重新打开尚未使用的原链接，或联系管理员。</p>
+   <button type="button" className={styles.secondary} onClick={onHome}>返回首页登录</button>
+  </>}
+  <p className={styles.hint}>请勿转发链接。本页不保存链接信息；刷新后可重新打开尚未使用的原链接。</p>
+ </section></main>;
+}
+
+function ResetForm({token,onHome}:{token:string;onHome:()=>void}){
+ const form=useAccountForm('reset',token);
+ return <>
+  {form.complete?<p className={styles.status} role="status">{form.message}</p>:<AccountForm form={form}/>}
+  <button type="button" className={styles.secondary} disabled={form.busy} onClick={onHome}>返回首页登录</button>
+ </>;
+}
