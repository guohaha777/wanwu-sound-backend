{
  "name": "wanwu-sound-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "万物声谱独立后端、音频任务与前后端共用包",
  "engines": {"node": ">=24.21.0"},
  "workspaces": ["apps/api", "apps/worker", "packages/contracts", "packages/sound-rules", "packages/audio-engine", "packages/prompts", "packages/music-features"],
  "scripts": {
    "typecheck": "npm run typecheck --workspace=@wanwu-v2/api && npm run typecheck --workspace=@wanwu-v2/worker",
    "test": "node --experimental-strip-types --test packages/sound-rules/tests/*.test.ts packages/audio-engine/tests/*.test.ts packages/prompts/tests/*.test.ts packages/music-features/tests/*.test.ts apps/worker/tests/unit/*.test.ts apps/api/tests/unit/*.test.ts tests/*.test.mjs",
    "build": "npm run typecheck && npm run check:catalogue && npm run check:shared",
    "check:catalogue": "node scripts/check-catalogue.mjs",
    "check:shared": "node scripts/check-shared.mjs",
    "shared:sync": "node scripts/sync-shared.mjs",
    "test:media": "node --experimental-strip-types --test --test-concurrency=1 apps/worker/tests/integration/*.test.ts",
    "test:api": "node scripts/test-api.mjs",
    "test:operations": "node scripts/test-api.mjs operations",
    "test:worker:runtime": "node scripts/test-api.mjs media-runtime",
    "prototype:media": "node apps/worker/src/prototype.ts",
    "verify:media:container": "node scripts/verify-media-container.mjs",
    "release:build": "node scripts/build-release.mjs",
    "test:release": "node scripts/test-release.mjs",
    "config:prepare": "node scripts/prepare-config.mjs",
    "api:start": "node --env-file-if-exists=.env.api apps/api/src/main.ts",
    "guest-ai:dev": "NODE_USE_ENV_PROXY=1 node --env-file=.env.models apps/api/src/guest/dev-cli.ts",
    "worker:start": "node --env-file-if-exists=.env.api apps/worker/src/main.ts",
    "db:bootstrap": "node --env-file-if-exists=.env.admin apps/api/src/db/bootstrap-cli.ts",
    "db:migrate": "node --env-file-if-exists=.env.admin apps/api/src/db/migrate.ts",
    "admin:create": "node --env-file-if-exists=.env.admin apps/api/src/admin-cli.ts",
    "catalogue:seed": "node --env-file-if-exists=.env.admin apps/api/src/catalogue-cli.ts",
    "ops:backup": "node --env-file-if-exists=.env.admin apps/api/src/maintenance/backup-cli.ts",
    "ops:cleanup": "node --env-file-if-exists=.env.api apps/api/src/maintenance/gc-cli.ts"
  },
  "devDependencies": {
    "@types/ali-oss": "6.23.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3"
  }
}
