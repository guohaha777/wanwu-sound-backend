# Separate file inside the existing http{} include. Review this file only; do not dump old secrets with nginx -T.
# Test the full configuration with nginx -t before any graceful reload; never restart shared Nginx.
log_format wanwu_minimal escape=json '{"time":"$time_iso8601","method":"$request_method","status":$status,"seconds":$request_time}';
server {
    listen 80;
    server_name wanwu-api.proterm.ink;
    access_log /var/log/nginx/wanwu-access.log wanwu_minimal;
    error_log /dev/null;
    location ^~ /.well-known/acme-challenge/ { root /srv/wudaizii/wanwu-sound/acme; }
    location / { return 301 https://wanwu-api.proterm.ink$request_uri; }
}
server {
    listen 443 ssl;
    server_name wanwu-api.proterm.ink;
    ssl_certificate /etc/letsencrypt/live/wanwu-api.proterm.ink/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wanwu-api.proterm.ink/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/wanwu-access.log wanwu_minimal;
    # Nginx error messages can contain complete request/share tokens. Structured API errors and health checks replace them.
    error_log /dev/null;
    add_header Referrer-Policy no-referrer always;
    add_header X-Content-Type-Options nosniff always;
    client_max_body_size 256k;
    location ^~ /api/v1/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host wanwu-api.proterm.ink;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host wanwu-api.proterm.ink;
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
        proxy_buffering off;
    }
    location / { return 404; }
}
