# 游客 AI 的内置模型配置。服务器上的真实文件：/etc/wanwu-sound/.env.models（root 所有，权限 600）。
# 由产品负责人自己填写；不要提交真实值，不要发给前端或写进聊天。说明见 docs/development/guest-ai.md。

# 语言模型（OpenAI 兼容 chat/completions）。三项都填才生效；留空 = 心情、讲解润色、AI 音符背景返回 not-open。
WANWU_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
WANWU_LLM_MODEL=qwen3.8-flash
WANWU_LLM_API_KEY=

# 音乐模型（AI 音频背景）。WANWU_MUSIC_PROVIDER 留空 = 这一档关闭，页面自动用 AI 音符或本地背景。
# 目前只支持 fun-music（适配器待接口文档确认后实现）。
WANWU_MUSIC_PROVIDER=
WANWU_MUSIC_BASE_URL=
WANWU_MUSIC_MODEL=
WANWU_MUSIC_API_KEY=

# 内置配置每天最多调用多少次（北京时间零点重置）。访客自己在「API 输入」填的不计入。
WANWU_GUEST_AI_DAILY_LIMIT=2000
